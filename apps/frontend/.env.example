# WalletConnect Cloud project id (required for the mobile QR connect flow). Get one free at
# https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Filled in by `pnpm --filter contracts deploy:testnet` (see packages/shared/src/constants/testnet.json)
NEXT_PUBLIC_IDENTITY_REGISTRY_ADDRESS=
NEXT_PUBLIC_SOCIAL_GRAPH_ADDRESS=

# apps/relay base URL, used once the gasless onboarding flow is wired up.
NEXT_PUBLIC_RELAY_URL=http://localhost:4000

NEXT_PUBLIC_BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545
