PORT=4000
CORS_ORIGIN=*

# Must be an endpoint that serves eth_getLogs — the relay replays chain history on boot. The
# binance.org data-seed-prebsc-* endpoints answer "limit exceeded" to every eth_getLogs call, even
# for a single block, so history replay silently degrades to live-events-only on those.
BSC_TESTNET_RPC_URL=https://bsc-testnet-rpc.publicnode.com

# Block the relay replays chain history from on boot, so a restart mid-workshop rebuilds the graph
# instead of resetting the leaderboard. Set it to the chain head when the event starts — NOT the
# deployment block: BSC testnet makes ~1.3M blocks a week and public RPCs prune old logs, so a deep
# replay is both slow and incomplete. Unset = replay the last ~10k blocks only.
RELAY_START_BLOCK=

# Filled in by `pnpm --filter contracts deploy:testnet`.
IDENTITY_REGISTRY_ADDRESS=
SOCIAL_GRAPH_ADDRESS=
REPUTATION_PASSPORT_ADDRESS=
FOUNDER_PASSPORT_ADDRESS=

# Throwaway testnet-only hot wallet used to submit gasless *For() transactions on behalf of
# attendees. Generate fresh for the event, fund it from the BSC testnet faucet, never reuse.
RELAY_HOT_WALLET_PRIVATE_KEY=
