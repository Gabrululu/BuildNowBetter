# Private key of the throwaway testnet deployer/relay hot wallet. Never reuse, never fund with real assets.
RELAY_DEPLOYER_PRIVATE_KEY=

# BSC Testnet RPC endpoint (chainId 97). publicnode is the default because, unlike the
# binance.org data-seed endpoints, it serves eth_getLogs (which apps/relay needs on boot).
BSC_TESTNET_RPC_URL=https://bsc-testnet-rpc.publicnode.com

# BscScan API key, only needed for `hardhat verify`.
BSCSCAN_API_KEY=
